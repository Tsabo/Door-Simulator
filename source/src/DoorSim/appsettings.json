{
  "Urls": "http://0.0.0.0:5000",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "OSDP.Net": "Warning",
        "OSDP.Net.Messages": "Warning",
        "OSDP.Net.Connections": "Warning"
      }
    }
  },
  // Point this at your own Seq instance (or override via the Seq__ServerUrl
  // environment variable / appsettings.Production.json on the Pi).
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DoorSim": "Data Source=/var/lib/doorsim/cards.db"
  },
  "Modbus": {
    // BCM GPIO pin number wired to DE+/RE- on the Bus 2 MAX485 module.
    // Set this to whichever pin you chose. null = DE/RE not software-controlled.
    // USB-RS485 adapters (ttyACM/ttyUSB) should keep this null.
    "DeRePinBcm": null,
    "BaudRate": 9600,
    "Parity": "None",
    "DataBits": 8,
    "StopBits": "One",
    "ReadTimeoutMs": 500,
    "WriteTimeoutMs": 500,
    "ResponseTimeoutMs": 450,
    "NoResponseRetries": 1
  }
}
