@inject DoorApiClient Doors

<MudDialog>
    <DialogContent>
        <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Elevation="0" Rounded="true">
            <MudTabPanel Text="General">
                <MudTextField @bind-Value="_form.Label"
                              Label="Label"
                              Placeholder="e.g. Main Entry"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4 mt-4" />

                <MudSelect T="ProtocolType" Value="@_form.Protocol"
                           ValueChanged="OnProtocolChanged"
                           Label="Protocol"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="mb-4">
                    @foreach (var proto in Enum.GetValues<ProtocolType>())
                    {
                        <MudSelectItem Value="@proto">@proto</MudSelectItem>
                    }
                </MudSelect>

                @if (_form.Protocol == ProtocolType.Wiegand)
                {
                    <MudNumericField T="int?" @bind-Value="_form.D0Pin"
                                     Label="D0 Pin (BCM)"
                                     Min="0"
                                     Max="27"
                                     Placeholder="e.g. 4"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="mb-4" />

                    <MudNumericField T="int?" @bind-Value="_form.D1Pin"
                                     Label="D1 Pin (BCM)"
                                     Min="0"
                                     Max="27"
                                     Placeholder="e.g. 27"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="mb-4" />
                }
                else
                {
                    <MudNumericField T="byte?" @bind-Value="_form.OsdpAddress"
                                     Label="OSDP Address (0–126)"
                                     Min="0"
                                     Max="126"
                                     Placeholder="e.g. 0"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="mb-4" />

                    <MudSelect T="string" @bind-Value="_form.OsdpSerialPort"
                               Label="Serial Port"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="mb-4">
                        @if (!string.IsNullOrWhiteSpace(_form.OsdpSerialPort) && !_availableSerialPorts.Any(p => string.Equals(p, _form.OsdpSerialPort, StringComparison.OrdinalIgnoreCase)))
                        {
                            <MudSelectItem Value="@_form.OsdpSerialPort">@_form.OsdpSerialPort (not detected)</MudSelectItem>
                        }
                        @foreach (var port in _availableSerialPorts)
                        {
                            <MudSelectItem Value="@port">@port</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="int?" @bind-Value="_form.OsdpBaudRate"
                               Label="Baud Rate"
                               HelperText="Leave as default unless both the panel and the adapter channel support the chosen rate."
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="mb-4">
                        <MudSelectItem T="int?" Value="@((int?)null)">Default (@OsdpBaudRates.Default)</MudSelectItem>
                        @foreach (var baud in OsdpBaudRates.Supported)
                        {
                            <MudSelectItem T="int?" Value="@((int?)baud)">@baud</MudSelectItem>
                        }
                    </MudSelect>

                }
            </MudTabPanel>

            <MudTabPanel Text="Advanced OSDP" Disabled="@(_form.Protocol != ProtocolType.Osdp)">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4 mt-4">
                    These settings change only what the PD <b>declares</b> to the panel. DoorSim's actual
                    behaviour is unchanged — declaring a capability it doesn't implement is a deliberate
                    negative-test tool. Leave a field blank to use the simulator default.
                </MudAlert>

                <MudExpansionPanels MultiExpansion="true" Elevation="0">

                    <MudExpansionPanel Text="Advertised Capabilities (osdp_CAP)">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Already advertised — tune the declared level</MudText>

                        <MudSelect T="byte?" @bind-Value="_form.OsdpCapCardDataFormatCompliance"
                                   Label="Card data format"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-4">
                            <MudSelectItem T="byte?" Value="@((byte?)null)">Default (@DefaultLevelLabel(OsdpAdvancedDefaults.CardDataFormatLevels, OsdpAdvancedDefaults.CardDataFormatCompliance))</MudSelectItem>
                            @foreach (var level in OsdpAdvancedDefaults.CardDataFormatLevels)
                            {
                                <MudSelectItem T="byte?" Value="@((byte?)level.Value)">@level.Label</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="byte?" @bind-Value="_form.OsdpCapLedControlCompliance"
                                   Label="Reader LED control"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-4">
                            <MudSelectItem T="byte?" Value="@((byte?)null)">Default (@DefaultLevelLabel(OsdpAdvancedDefaults.LedControlLevels, OsdpAdvancedDefaults.LedControlCompliance))</MudSelectItem>
                            @foreach (var level in OsdpAdvancedDefaults.LedControlLevels)
                            {
                                <MudSelectItem T="byte?" Value="@((byte?)level.Value)">@level.Label</MudSelectItem>
                            }
                        </MudSelect>

                        <MudNumericField T="byte?" @bind-Value="_form.OsdpCapLedsPerReader"
                                         Label="LEDs per reader"
                                         Min="1"
                                         Max="255"
                                         Placeholder="@OsdpAdvancedDefaults.LedsPerReader.ToString()"
                                         HelperText="Declared only. DoorSim drives a single LED regardless."
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />

                        <MudSelect T="byte?" @bind-Value="_form.OsdpCapCheckCharacterCompliance"
                                   Label="Check character support"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.Warning"
                                   AdornmentColor="Color.Warning"
                                   HelperText="Declaration only — DoorSim always accepts CRC-16. A panel that honours a checksum-only declaration may switch framing and the link will drop."
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-4">
                            <MudSelectItem T="byte?" Value="@((byte?)null)">Default (@DefaultLevelLabel(OsdpAdvancedDefaults.CheckCharacterLevels, OsdpAdvancedDefaults.CheckCharacterCompliance))</MudSelectItem>
                            @foreach (var level in OsdpAdvancedDefaults.CheckCharacterLevels)
                            {
                                <MudSelectItem T="byte?" Value="@((byte?)level.Value)">@level.Label</MudSelectItem>
                            }
                        </MudSelect>

                        <MudDivider Class="mb-4" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Not advertised by default — pick a level to declare</MudText>

                        <MudSelect T="byte?" @bind-Value="_form.OsdpCapContactStatusCompliance"
                                   Label="Contact status monitoring"
                                   HelperText="DoorSim reports two inputs (DPS, REX) whatever it declares."
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-4">
                            <MudSelectItem T="byte?" Value="@((byte?)null)">Not advertised (default)</MudSelectItem>
                            @foreach (var level in OsdpAdvancedDefaults.ContactStatusLevels)
                            {
                                <MudSelectItem T="byte?" Value="@((byte?)level.Value)">@level.Label</MudSelectItem>
                            }
                        </MudSelect>

                        <MudNumericField T="byte?" @bind-Value="_form.OsdpCapContactStatusInputs"
                                         Label="Declared input count"
                                         Min="1"
                                         Max="255"
                                         Placeholder="@OsdpAdvancedDefaults.ContactStatusInputs.ToString()"
                                         Disabled="@(_form.OsdpCapContactStatusCompliance is null)"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />

                        <MudSelect T="byte?" @bind-Value="_form.OsdpCapOutputControlCompliance"
                                   Label="Output control"
                                   HelperText="DoorSim acknowledges osdp_OUT but drives nothing."
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-4">
                            <MudSelectItem T="byte?" Value="@((byte?)null)">Not advertised (default)</MudSelectItem>
                            @foreach (var level in OsdpAdvancedDefaults.OutputControlLevels)
                            {
                                <MudSelectItem T="byte?" Value="@((byte?)level.Value)">@level.Label</MudSelectItem>
                            }
                        </MudSelect>

                        <MudNumericField T="byte?" @bind-Value="_form.OsdpCapOutputControlCount"
                                         Label="Declared output count"
                                         Min="1"
                                         Max="255"
                                         Placeholder="@OsdpAdvancedDefaults.OutputControlCount.ToString()"
                                         Disabled="@(_form.OsdpCapOutputControlCompliance is null)"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />

                        <MudSelect T="byte?" @bind-Value="_form.OsdpCapAudibleOutputCompliance"
                                   Label="Reader audible output"
                                   HelperText="Backed for real — DoorSim already handles osdp_BUZ and drives the mock buzzer."
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-4">
                            <MudSelectItem T="byte?" Value="@((byte?)null)">Not advertised (default)</MudSelectItem>
                            @foreach (var level in OsdpAdvancedDefaults.AudibleOutputLevels)
                            {
                                <MudSelectItem T="byte?" Value="@((byte?)level.Value)">@level.Label</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="byte?" @bind-Value="_form.OsdpCapTextOutputCompliance"
                                   Label="Reader text output"
                                   HelperText="DoorSim logs osdp_TEXT but renders nothing. Declaring level 0 is different from not advertising at all."
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-4">
                            <MudSelectItem T="byte?" Value="@((byte?)null)">Not advertised (default)</MudSelectItem>
                            @foreach (var level in OsdpAdvancedDefaults.TextOutputLevels)
                            {
                                <MudSelectItem T="byte?" Value="@((byte?)level.Value)">@level.Label</MudSelectItem>
                            }
                        </MudSelect>

                        <MudNumericField T="byte?" @bind-Value="_form.OsdpCapTextOutputDisplays"
                                         Label="Declared display count"
                                         Min="0"
                                         Max="255"
                                         Placeholder="@OsdpAdvancedDefaults.TextOutputDisplays.ToString()"
                                         Disabled="@(_form.OsdpCapTextOutputCompliance is null)"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />

                        <MudDivider Class="mb-4" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Secure channel (declaration only)</MudText>

                        <MudSwitch T="bool" @bind-Value="_form.OsdpCapDeclareAes128"
                                   Color="Color.Warning"
                                   Label="Declare AES-128 support"
                                   Class="mb-2" />

                        <MudText Typo="Typo.caption" Class="mb-4 d-block">
                            Declaration only — cosmetic. DoorSim keeps <code>RequireSecurity = false</code> and will
                            not negotiate a secure channel (SCS); it has no SCBK. Use this to see how a panel reacts
                            to a PD that <i>claims</i> AES-128.
                        </MudText>

                        <MudSwitch T="bool" @bind-Value="_form.OsdpCapDeclareDefaultAesKey"
                                   Color="Color.Warning"
                                   Label="Declare the default AES-128 key"
                                   Disabled="@(!_form.OsdpCapDeclareAes128)"
                                   Class="mb-4" />

                        <MudDivider Class="mb-4" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Declaration-only extras</MudText>

                        <MudNumericField T="int?" @bind-Value="_form.OsdpCapReceiveBufferSize"
                                         Label="Receive buffer size (bytes)"
                                         Min="@OsdpAdvancedDefaults.MinMessageSize"
                                         Max="@OsdpAdvancedDefaults.MaxMessageSize"
                                         Placeholder="Not advertised"
                                         HelperText="Sent as a 16-bit value split across the two capability bytes."
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />

                        <MudNumericField T="int?" @bind-Value="_form.OsdpCapLargestCombinedMessageSize"
                                         Label="Largest combined message size (bytes)"
                                         Min="@OsdpAdvancedDefaults.MinMessageSize"
                                         Max="@OsdpAdvancedDefaults.MaxMessageSize"
                                         Placeholder="Not advertised"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />

                        <MudSelect T="byte?" @bind-Value="_form.OsdpCapOsdpVersion"
                                   Label="OSDP version"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-4">
                            <MudSelectItem T="byte?" Value="@((byte?)null)">Not advertised (default)</MudSelectItem>
                            @foreach (var level in OsdpAdvancedDefaults.OsdpVersionLevels)
                            {
                                <MudSelectItem T="byte?" Value="@((byte?)level.Value)">@level.Label</MudSelectItem>
                            }
                        </MudSelect>

                        <MudNumericField T="byte?" @bind-Value="_form.OsdpCapDownstreamReaders"
                                         Label="Downstream readers"
                                         Min="0"
                                         Max="255"
                                         Placeholder="Not advertised"
                                         HelperText="Declared count of attached downstream readers."
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense" />
                    </MudExpansionPanel>

                    <MudExpansionPanel Text="Device Identity (osdp_ID)">
                        <MudTextField @bind-Value="_form.OsdpIdVendorCode"
                                      Label="Vendor code"
                                      Placeholder="@OsdpAdvancedDefaults.VendorCodeText"
                                      HelperText="Three hex bytes. Accepts 00-00-01, 00 00 01 or 000001."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="mb-4" />

                        <MudNumericField T="byte?" @bind-Value="_form.OsdpIdModelNumber"
                                         Label="Model number"
                                         Min="0"
                                         Max="255"
                                         Placeholder="@OsdpAdvancedDefaults.ModelNumber.ToString()"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />

                        <MudNumericField T="byte?" @bind-Value="_form.OsdpIdHardwareVersion"
                                         Label="Hardware version"
                                         Min="0"
                                         Max="255"
                                         Placeholder="@OsdpAdvancedDefaults.HardwareVersion.ToString()"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />

                        <MudNumericField T="int?" @bind-Value="_form.OsdpIdSerialNumber"
                                         Label="Serial number"
                                         Placeholder="(door id)"
                                         HelperText="Also used as the connection cUID serial number."
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />

                        <MudNumericField T="byte?" @bind-Value="_form.OsdpIdFirmwareMajor"
                                         Label="Firmware major"
                                         Min="0"
                                         Max="255"
                                         Placeholder="@OsdpAdvancedDefaults.FirmwareMajor.ToString()"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />

                        <MudNumericField T="byte?" @bind-Value="_form.OsdpIdFirmwareMinor"
                                         Label="Firmware minor"
                                         Min="0"
                                         Max="255"
                                         Placeholder="@OsdpAdvancedDefaults.FirmwareMinor.ToString()"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />

                        <MudNumericField T="byte?" @bind-Value="_form.OsdpIdFirmwareBuild"
                                         Label="Firmware build"
                                         Min="0"
                                         Max="255"
                                         Placeholder="@OsdpAdvancedDefaults.FirmwareBuild.ToString()"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense" />
                    </MudExpansionPanel>

                    <MudExpansionPanel Text="Protocol Behaviour &amp; Timing">
                        <MudSelect T="bool" @bind-Value="_form.OsdpNakManufacturerCommand"
                                   Label="Manufacturer-specific (osdp_MFG) command reply"
                                   HelperText="DoorSim doesn't implement any vendor extension either way — this only controls which reply it sends back."
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-4">
                            <MudSelectItem T="bool" Value="false">Ack (default)</MudSelectItem>
                            <MudSelectItem T="bool" Value="true">Nak (unsupported command)</MudSelectItem>
                        </MudSelect>

                        <MudSelect T="OsdpComsetBehavior" @bind-Value="_form.OsdpComsetHandling"
                                   Label="Address change (osdp_COMSET) reply"
                                   HelperText="Accepting an address change takes effect on the next connection, never applies the requested baud rate, and does not update the stored door configuration."
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-4">
                            <MudSelectItem T="OsdpComsetBehavior" Value="OsdpComsetBehavior.Ignore">Ignore — reply with actual settings (default)</MudSelectItem>
                            <MudSelectItem T="OsdpComsetBehavior" Value="OsdpComsetBehavior.AcceptAddress">Accept — reply with requested settings</MudSelectItem>
                            <MudSelectItem T="OsdpComsetBehavior" Value="OsdpComsetBehavior.Nak">Nak — declare COMSET unsupported</MudSelectItem>
                        </MudSelect>

                        <MudNumericField T="int?" @bind-Value="_form.OsdpConnectionTimeoutSeconds"
                                         Label="Connection timeout (seconds)"
                                         Min="@OsdpAdvancedDefaults.MinConnectionTimeoutSeconds"
                                         Max="@OsdpAdvancedDefaults.MaxConnectionTimeoutSeconds"
                                         Placeholder="@OsdpAdvancedDefaults.ConnectionTimeoutSeconds.ToString()"
                                         HelperText="How long without a poll before the link counts as down."
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />

                        <MudNumericField T="int?" @bind-Value="_form.OsdpReplyTimeoutMilliseconds"
                                         Label="Reply timeout (ms)"
                                         Min="@OsdpAdvancedDefaults.MinReplyTimeoutMilliseconds"
                                         Max="@OsdpAdvancedDefaults.MaxReplyTimeoutMilliseconds"
                                         Placeholder="@OsdpAdvancedDefaults.ReplyTimeoutMilliseconds.ToString()"
                                         HelperText="Inter-byte gap tolerated within one frame. Must be shorter than the connection timeout."
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />

                        <MudSelect T="OsdpLedColor?" @bind-Value="_form.OsdpDefaultLedColor"
                                   Label="Default LED color"
                                   HelperText="Idle color shown before the panel sends its first osdp_LED command — useful for panels (e.g. Verkada, Inner Range Integriti) that never send one."
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            <MudSelectItem T="OsdpLedColor?" Value="@((OsdpLedColor?)null)">Off (simulator default)</MudSelectItem>
                            @foreach (var color in Enum.GetValues<OsdpLedColor>())
                            {
                                <MudSelectItem T="OsdpLedColor?" Value="@((OsdpLedColor?)color)">@color</MudSelectItem>
                            }
                        </MudSelect>
                    </MudExpansionPanel>

                </MudExpansionPanels>
            </MudTabPanel>

            <MudTabPanel Text="Door Contact (DPS)">
                <MudCheckBox T="bool" Value="@_form.HasDps"
                             ValueChanged="OnHasDpsChanged"
                             Label="Door Contact (DPS)"
                             Class="mb-4 mt-4" />

                @if (_form.HasDps)
                {
                    <MudRadioGroup T="bool" Value="@_form.DpsModeIsModbus"
                                   ValueChanged="OnDpsModeChanged"
                                   Class="mb-4">
                        <MudRadio T="bool" Value="false" Color="Color.Primary" Class="mb-2">
                            GPIO Pin
                        </MudRadio>
                        <MudRadio T="bool" Value="true" Color="Color.Primary">
                            Modbus Relay
                        </MudRadio>
                    </MudRadioGroup>

                    @if (!_form.DpsModeIsModbus)
                    {
                        <MudNumericField T="int?" @bind-Value="_form.DpsPin"
                                         Label="DPS Pin (BCM)"
                                         Min="0"
                                         Max="27"
                                         Placeholder="e.g. 21"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />
                    }
                    else
                    {
                        <MudNumericField T="int?" @bind-Value="_form.DpsModbusChannel"
                                         Label="DPS Channel (0–15)"
                                         Min="0"
                                         Max="15"
                                         Placeholder="e.g. 0"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />
                    }

                    <MudSwitch T="bool" @bind-Value="_form.DpsNormallyOpen"
                               Color="Color.Warning"
                               Label="@(_form.DpsNormallyOpen ? "Normally Open — Fail Safe" : "Normally Closed — Fail Secure")" />
                }
            </MudTabPanel>

            <MudTabPanel Text="REX">
                <MudCheckBox T="bool" Value="@_form.HasRex"
                             ValueChanged="OnHasRexChanged"
                             Label="REX Relay"
                             Class="mb-4 mt-4" />

                @if (_form.HasRex)
                {
                    <MudRadioGroup T="bool" Value="@_form.RexModeIsModbus"
                                   ValueChanged="OnRexModeChanged"
                                   Class="mb-4">
                        <MudRadio T="bool" Value="false" Color="Color.Primary" Class="mb-2">
                            GPIO Pin
                        </MudRadio>
                        <MudRadio T="bool" Value="true" Color="Color.Primary">
                            Modbus Relay
                        </MudRadio>
                    </MudRadioGroup>

                    @if (!_form.RexModeIsModbus)
                    {
                        <MudNumericField T="int?" @bind-Value="_form.RexPin"
                                         Label="REX Pin (BCM)"
                                         Min="0"
                                         Max="27"
                                         Placeholder="e.g. 13"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />
                    }
                    else
                    {
                        <MudNumericField T="int?" @bind-Value="_form.RexModbusChannel"
                                         Label="REX Channel (0–15)"
                                         Min="0"
                                         Max="15"
                                         Placeholder="e.g. 1"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="mb-4" />
                    }

                    <MudSwitch T="bool" @bind-Value="_form.RexNormallyOpen"
                               Color="Color.Warning"
                               Label="@(_form.RexNormallyOpen ? "Normally Open — Fail Safe" : "Normally Closed — Fail Secure")" />
                }
            </MudTabPanel>

            <MudTabPanel Text="Relay Board" Disabled="@(!AnyModbus)">
                <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-4 mt-4">
                    Shared by DPS and REX when either is set to Modbus Relay — one physical board, addressed by channel.
                </MudText>

                <MudRadioGroup T="bool" Value="@_form.ModbusTransportIsTcp"
                               ValueChanged="OnModbusTransportChanged"
                               Class="mb-4">
                    <MudRadio T="bool" Value="false" Color="Color.Primary" Class="mb-2">
                        RTU (RS-485 serial)
                    </MudRadio>
                    <MudRadio T="bool" Value="true" Color="Color.Primary">
                        TCP (Ethernet)
                    </MudRadio>
                </MudRadioGroup>

                @if (!_form.ModbusTransportIsTcp)
                {
                    <MudSelect T="string" @bind-Value="_form.ModbusSerialPort"
                               Label="Serial Port"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="mb-4">
                        @if (!string.IsNullOrWhiteSpace(_form.ModbusSerialPort) && !_availableSerialPorts.Any(p => string.Equals(p, _form.ModbusSerialPort, StringComparison.OrdinalIgnoreCase)))
                        {
                            <MudSelectItem Value="@_form.ModbusSerialPort">@_form.ModbusSerialPort (not detected)</MudSelectItem>
                        }
                        @foreach (var port in _availableSerialPorts)
                        {
                            <MudSelectItem Value="@port">@port</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudTextField @bind-Value="_form.ModbusTcpHost"
                                  Label="Host / IP"
                                  Placeholder="e.g. 192.168.1.100"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="mb-4" />

                    <MudNumericField T="int?" @bind-Value="_form.ModbusTcpPort"
                                     Label="Port (default 502)"
                                     Min="1"
                                     Max="65535"
                                     Placeholder="502"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="mb-4" />
                }

                <MudNumericField T="byte?" @bind-Value="_form.ModbusUnitId"
                                 Label="Unit ID (1–247)"
                                 Min="1"
                                 Max="247"
                                 Placeholder="e.g. 1"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudTabPanel>
        </MudTabs>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">
                @_error
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveAsync"
                   Disabled="@_saving">
            @(_saving ? "Saving…" : (Editing is null ? "Add" : "Save"))
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="Cancel">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>
