@page "/"
@inject SimulationApiClient Sim
@inject CardApiClient Cards
@inject DoorApiClient Doors
@inject IDialogService Dialog
@implements IAsyncDisposable

<PageTitle>Reader Panel — DoorSim</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Reader Panel</MudText>

@if (_loading)
{
    <MudContainer Class="d-flex justify-center mt-16">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudContainer>
}
else if (_doors.Length == 0)
{
    <MudAlert Severity="Severity.Info">
        No doors configured — visit <MudLink Href="doors">Door Config</MudLink> to add one.
    </MudAlert>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var door in _doors)
        {
            var doorId  = door.Id;
            var hasDps  = HasDps(door);
            var hasRex  = HasRex(door);
            var hasCard = _cards.Length > 0;

            <MudItem xs="12" sm="6" md="4">
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex align-center justify-space-between">
                                <MudText Typo="Typo.body1">@door.Label</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.FormatListNumbered"
                                               Size="Size.Small"
                                               Color="@(_queueDepths.TryGetValue(doorId, out var qd) && qd > 0 ? Color.Info : Color.Default)"
                                               title="View simulation queue"
                                               OnClick="@(() => OpenQueueDialogAsync(doorId, door.Label))" />
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>

                    <MudCardContent Style="padding-top: 5px;">
                        @* ── Top row: reader SVG  |  status chips  |  door SVG ── *@
                        <div class="d-flex gap-3 align-start mb-3">

                            @* Reader + chips *@
                            <div style="flex: 1 1 auto; min-width: 0;">
                                <div class="d-flex gap-3 align-start mb-2">
                                    <MockReader Label="@door.Label"
                                                Protocol="@door.Protocol"
                                                IsConnected="@(_connectivity.TryGetValue(doorId, out var conn) && conn)"
                                                LedState="@(_ledStates.GetValueOrDefault(doorId))"
                                                SimStatus="@_statuses[doorId]" />

                                    <MudStack Spacing="1" Style="flex-wrap: wrap; align-content: flex-start;">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                                 Variant="Variant.Text">
                                            @door.Protocol
                                        </MudChip>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@StatusColor(_statuses[doorId])"
                                                 Variant="Variant.Filled"
                                                 Icon="@StatusIcon(_statuses[doorId])">
                                            @_statuses[doorId]
                                        </MudChip>
                                        @if (door.Protocol == ProtocolType.Osdp)
                                        {
                                            var connected = _connectivity.TryGetValue(doorId, out var c) && c;
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@(connected ? Color.Success : Color.Error)"
                                                     Variant="Variant.Filled"
                                                     Icon="@(connected ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)">
                                                @(connected ? "Connected" : "Disconnected")
                                            </MudChip>
                                        }
                                        @if (_queueDepths.TryGetValue(doorId, out var qDepth) && qDepth > 0)
                                        {
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="Color.Info"
                                                     Variant="Variant.Filled"
                                                     Icon="@Icons.Material.Filled.FormatListNumbered"
                                                     OnClick="@(() => OpenQueueDialogAsync(doorId, door.Label))"
                                                     Style="cursor: pointer;">
                                                Queue: @qDepth
                                            </MudChip>
                                        }
                                    </MudStack>
                                </div>
                                @if (_currentActions.TryGetValue(doorId, out var currentAction) && !string.IsNullOrWhiteSpace(currentAction) && _statuses[doorId] == SimulationStatus.Running)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block text-truncate" Style="max-width: 220px;" title="@currentAction">
                                        @currentAction
                                    </MudText>
                                }
                            </div>

                            @* Door + REX (only when DPS is configured) *@
                            @if (hasDps)
                            {
                                <MockDoor HasDps="true"
                                          HasRex="@hasRex"
                                          DoorIsOpen="@(_doorOpen.TryGetValue(doorId, out var dOpen) && dOpen)"
                                          RexIsActive="@(_rexActive.TryGetValue(doorId, out var rActive) && rActive)"
                                          DpsNormallyOpen="@door.DpsNormallyOpen"
                                          RexNormallyOpen="@door.RexNormallyOpen"
                                          Busy="@IsBusy(doorId)"
                                          OnDoorToggle="@(() => ToggleDoorAsync(doorId))"
                                          OnRexTrigger="@(() => TriggerRexAsync(doorId))" />
                            }
                        </div>

                        @* ── Card selector ── *@
                        @if (hasCard)
                        {
                            <MudSelect T="int" @bind-Value="_selectedCard[doorId]"
                                       Label="Card"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense">
                                @foreach (var card in _cards)
                                {
                                    <MudSelectItem Value="@card.Id">
                                        @card.Label (FC @card.FacilityCode / @card.CardNumber)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                No cards in library.
                            </MudAlert>
                        }

                        @if (_errors.TryGetValue(doorId, out var err) && err is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@err</MudAlert>
                        }
                    </MudCardContent>

                    @* ── Action buttons — shown only when the hardware supports the action ── *@
                    <MudCardActions>
                        <MudStack Class="flex-grow-1" Spacing="1">

                            @* Card Read: needs a card in the library *@
                            @if (hasCard)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           FullWidth="true"
                                           OnClick="@(() => SendEventAsync(doorId, DoorEventType.CardReadOnly))"
                                           Disabled="@IsBusy(doorId)">
                                    Card Read Only
                                </MudButton>
                            }

                            @* Access Cycle: card read + door open/close — needs DPS *@
                            @if (hasCard && hasDps)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           FullWidth="true"
                                           OnClick="@(() => SendEventAsync(doorId, DoorEventType.AccessCycle))"
                                           Disabled="@IsBusy(doorId)">
                                    Access Cycle
                                </MudButton>
                            }

                            @* Egress Cycle: REX + door open/close — needs both DPS and REX *@
                            @if (hasDps && hasRex)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           FullWidth="true"
                                           OnClick="@(() => SendEventAsync(doorId, DoorEventType.EgressCycle))"
                                           Disabled="@IsBusy(doorId)">
                                    Egress Cycle
                                </MudButton>
                            }

                            @* Fallback when nothing is actionable *@
                            @if (!hasCard && !hasDps)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    Add a card or configure DPS / REX to enable controls.
                                </MudAlert>
                            }

                        </MudStack>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}
