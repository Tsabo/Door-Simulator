@page "/settings"
@inject SettingsApiClient SettingsClient
@inject SystemApiClient SystemClient

<PageTitle>Settings — DoorSim</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Settings</MudText>

@if (_loading)
{
    <MudContainer Class="d-flex justify-center mt-16">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudContainer>
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Simulation Timing</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Tertiary">
                            Applied globally to all doors and all simulation cycles.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent>
                    <MudNumericField T="int" @bind-Value="_form.CardToDoorDelayMs"
                                     Label="Card-to-door delay (ms)"
                                     Min="0"
                                     Max="10000"
                                     Step="100"
                                     HelperText="Delay after card read before the door unlocks"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="mb-4" />

                    <MudNumericField T="int" @bind-Value="_form.DoorOpenMs"
                                     Label="Door open duration (ms)"
                                     Min="500"
                                     Max="60000"
                                     Step="500"
                                     HelperText="How long the door stays open before closing"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="mb-4" />

                    <MudNumericField T="int" @bind-Value="_form.RexLeadMs"
                                     Label="REX lead time (ms)"
                                     Min="0"
                                     Max="5000"
                                     Step="100"
                                     HelperText="How long REX is active before the door opens (egress cycle)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="mb-4" />

                    <MudNumericField T="int" @bind-Value="_form.QuickRexMs"
                                     Label="Quick REX duration (ms)"
                                     Min="500"
                                     Max="30000"
                                     Step="500"
                                     HelperText="How long a standalone REX pulse lasts (no door movement)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="mb-4" />

                    <MudNumericField T="int" @bind-Value="_form.QueueItemDelayMs"
                                     Label="Queue item delay (ms)"
                                     Min="0"
                                     Max="60000"
                                     Step="100"
                                     HelperText="Delay between consecutive queued actions on the same reader"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="mb-4" />

                    <MudNumericField T="int" @bind-Value="_form.MetricsRetentionDays"
                                     Label="Telemetry retention (days)"
                                     Min="0"
                                     Max="3650"
                                     Step="1"
                                     HelperText="Older telemetry events are purged at startup. 0 keeps them forever."
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />

                    @if (_error is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">@_error</MudAlert>
                    }

                    @if (_saved)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-4">Settings saved.</MudAlert>
                    }
                </MudCardContent>

                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SaveAsync"
                               Disabled="@_saving">
                        @(_saving ? "Saving…" : "Save")
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Host</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Tertiary">
                            The machine running the DoorSim server.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent>
                    @if (_systemInfo is null)
                    {
                        <MudText Typo="Typo.body2">Host details unavailable.</MudText>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Elevation="0">
                            <tbody>
                                <tr><td>Version</td><td>@_systemInfo.Version</td></tr>
                                <tr><td>Operating system</td><td>@_systemInfo.OperatingSystem</td></tr>
                                <tr><td>Architecture</td><td>@_systemInfo.Architecture</td></tr>
                                <tr>
                                    <td>GPIO</td>
                                    <td>
                                        @if (_systemInfo.GpioAvailable)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success">Available</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">Unavailable</MudChip>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>

                        @if (!_systemInfo.GpioAvailable)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">
                                Wiegand doors and GPIO door contacts need a Raspberry Pi. On this host, use OSDP
                                for card reads and a Modbus relay board for DPS/REX.
                            </MudAlert>
                        }
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}
