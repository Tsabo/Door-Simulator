@page "/cards"
@inject CardApiClient Cards
@inject CardFormatApiClient Formats

<PageTitle>Card Library — DoorSim</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Card Library</MudText>

@if (_loading)
{
    <MudContainer Class="d-flex justify-center mt-16">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudContainer>
}
else
{
    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            @(_editing is null ? "Add Card" : $"Edit: {_editing.Label}")
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent>
                    <MudTextField @bind-Value="_form.Label"
                                  Label="Label"
                                  Placeholder="e.g. Main Lobby Badge"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="mb-4" />

                    <MudNumericField T="int" @bind-Value="_form.FacilityCode"
                                     Label="Facility Code (0–65535)"
                                     Min="0"
                                     Max="65535"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="mb-4" />

                    <MudNumericField T="uint" @bind-Value="_form.CardNumber"
                                     Label="Card Number"
                                     Min="0"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="mb-4" />

                    <MudSelect T="FormatChoice" @bind-Value="_form.Choice"
                               Label="Format"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="mb-4"
                               ToStringFunc="@DescribeChoice">
                        <MudSelectItem Value="@BuiltInHeader" Disabled="true">Built-in</MudSelectItem>
                        @foreach (var fmt in Enum.GetValues<WiegandFormat>().Where(f => f != WiegandFormat.Custom))
                        {
                            <MudSelectItem Value="@(new FormatChoice(fmt, null))">@fmt</MudSelectItem>
                        }
                        @if (_customFormats.Length > 0)
                        {
                            <MudSelectItem Value="@CustomHeader" Disabled="true">Custom</MudSelectItem>
                            @foreach (var cf in _customFormats)
                            {
                                <MudSelectItem Value="@(new FormatChoice(WiegandFormat.Custom, cf.Id))">@cf.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>

                    @if (_error is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
                            @_error
                        </MudAlert>
                    }
                </MudCardContent>

                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SaveAsync"
                               Disabled="@_saving">
                        @(_saving ? "Saving…" : (_editing is null ? "Add" : "Save"))
                    </MudButton>
                    @if (_editing is not null)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   OnClick="CancelEdit">
                            Cancel
                        </MudButton>
                    }
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="mb-4">Cards</MudText>
    <MudTable Items="_cards" Dense="true" Striped="true" Hover="true">
        <HeaderContent>
            <MudTh>Label</MudTh>
            <MudTh>FC</MudTh>
            <MudTh>Card #</MudTh>
            <MudTh>Format</MudTh>
            <MudTh>Created</MudTh>
            <MudTh Style="text-align:center">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Label">@context.Label</MudTd>
            <MudTd DataLabel="FC">@context.FacilityCode</MudTd>
            <MudTd DataLabel="Card #">@context.CardNumber</MudTd>
            <MudTd DataLabel="Format">
                @(context.Format == WiegandFormat.Custom
                    ? _customFormats.FirstOrDefault(f => f.Id == context.CustomFormatId)?.Name ?? "Custom (deleted)"
                    : context.Format.ToString())
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.LocalDateTime.ToString("g")</MudTd>
            <MudTd DataLabel="Actions" Style="text-align:center">
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="() => BeginEdit(context)">
                    Edit
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Size="Size.Small"
                           OnClick="() => DeleteAsync(context.Id)">
                    Delete
                </MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudTd colspan="6" Style="text-align:center; padding: 24px;">
                <MudText Color="Color.Tertiary">No cards yet.</MudText>
            </MudTd>
        </NoRecordsContent>
    </MudTable>
}
