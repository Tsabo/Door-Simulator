@page "/cards"
@inject CardApiClient Cards
@inject CardFormatApiClient Formats
@inject IDialogService Dialog

<PageTitle>Card Library — DoorSim</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Card Library</MudText>

@if (_loading)
{
    <MudContainer Class="d-flex justify-center mt-16">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudContainer>
}
else
{
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
            @_error
        </MudAlert>
    }

    <div class="d-flex align-center mb-4">
        <MudText Typo="Typo.h6">Cards</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialogAsync">
            Add Card
        </MudButton>
    </div>

    <MudTable Items="_cards" Dense="true" Striped="true" Hover="true">
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Label</MudTh>
            <MudTh>FC</MudTh>
            <MudTh>Card #</MudTh>
            <MudTh>Format</MudTh>
            <MudTh>Created</MudTh>
            <MudTh Style="text-align:center">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Label">@context.Label</MudTd>
            <MudTd DataLabel="FC">@context.FacilityCode</MudTd>
            <MudTd DataLabel="Card #">@context.CardNumber</MudTd>
            <MudTd DataLabel="Format">
                @(context.Format == WiegandFormat.Custom
                    ? _customFormats.FirstOrDefault(f => f.Id == context.CustomFormatId)?.Name ?? "Custom (deleted)"
                    : context.Format.ToString())
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.LocalDateTime.ToString("g")</MudTd>
            <MudTd DataLabel="Actions" Style="text-align:center">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="() => OpenEditDialogAsync(context)"/>
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="() => DeleteAsync(context.Id)"/>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudTd colspan="6" Style="text-align:center; padding: 24px;">
                <MudText Color="Color.Tertiary">No cards yet.</MudText>
            </MudTd>
        </NoRecordsContent>
    </MudTable>
}
